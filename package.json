{
  "name": "av-backup",
  "version": "1.6.9",
  "description": "Organise camera-original footage into the house folder structure",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test:renderer": "node --test tests/*.test.js",
    "bundle:python": "node scripts/build-python.js",
    "dist": "npm run bundle:python && electron-builder",
    "dist:mac": "bash scripts/macos.sh build",
    "setup:mac": "bash scripts/macos.sh setup",
    "dist:win": "npm run bundle:python && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.house.videoingest",
    "productName": "AV Backup",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**"
    ],
    "extraResources": [
      {
        "from": "dist-python",
        "to": "python"
      }
    ],
    "mac": {
      "category": "public.app-category.video",
      "minimumSystemVersion": "12.0",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "icon": "renderer/assets/icon.icns"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "signAndEditExecutable": true,
      "icon": "renderer/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/guj": "1.0.0",
    "pdfjs-dist": "3.11.174",
    "tesseract.js": "7.0.0"
  }
}
