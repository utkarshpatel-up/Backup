{
  "name": "video-ingest",
  "version": "1.0.0",
  "description": "Organise camera-original footage into the house folder structure",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test:renderer": "node --test tests/*.test.js",
    "bundle:python": "node scripts/build-python.js",
    "dist": "npm run bundle:python && electron-builder",
    "dist:mac": "bash scripts/macos.sh build",
    "setup:mac": "bash scripts/macos.sh setup",
    "dist:win": "npm run bundle:python && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.house.videoingest",
    "productName": "Video Ingest",
    "files": ["electron/**/*", "renderer/**/*", "package.json"],
    "extraResources": [{ "from": "dist-python", "to": "python" }],
    "mac": { "category": "public.app-category.video", "target": ["dmg", "zip"], "artifactName": "${productName}-${version}-mac-${arch}.${ext}" },
    "win": { "target": ["nsis"], "signAndEditExecutable": false },
    "linux": { "target": ["AppImage"] }
  }
}
